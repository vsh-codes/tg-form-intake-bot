# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAEexampleexampleexampleexampleexample

# Your Telegram user ID (numeric) — get from @userinfobot
# This is who receives notifications about new applications.
ADMIN_CHAT_ID=123456789

# Target Google Sheet ID
# Get from the URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Path to the service account JSON key
# See README.md for setup instructions.
GOOGLE_SERVICE_ACCOUNT_PATH=credentials/service-account.json

# Optional: name of the worksheet tab (defaults to first tab)
GOOGLE_WORKSHEET_NAME=Applications

# Local SQLite path for deduplication and draft state
DATABASE_PATH=data/bot.db

# Logging
LOG_LEVEL=INFO
